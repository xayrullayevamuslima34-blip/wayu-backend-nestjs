# Main database
DB_URL=postgresql://postgres:password@localhost:5432/wayu

# E2E tests (a fresh "wayu_test" database is created on every run)
DEFAULT_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/wayu_test

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Public URL used to build links to uploaded files
BASE_URL=http://localhost:8888
